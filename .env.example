# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# URL of your Express backend. In development this is localhost.
# In production set this to your deployed server URL (e.g. https://codefolio.onrender.com)
VITE_API_URL=http://localhost:3001

# ─── Backend (Node / Express) ─────────────────────────────────────────────────
# Port the Express server listens on
PORT=3001

# Environment — set to "production" on your server
NODE_ENV=development

# Allowed origin for CORS (your frontend URL in production)
CLIENT_ORIGIN=http://localhost:5173

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → your project → Settings → API
# The service role key is used SERVER-SIDE only — never expose it to the browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Get this from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# ─── SMTP / Email (for OTP delivery) ──────────────────────────────────────────
# Any SMTP provider works: Gmail, Mailgun, Resend, Brevo, etc.
#
# Gmail example (use an App Password, not your real password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Resend example:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=your-resend-api-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Codefolio <your-email@gmail.com>
